# IDE
.idea/

# Claude Code (allow settings.json, agents/, and skills/)
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/skills/
.ralph.stop

# OS
.DS_Store

# Node / Frontend
node_modules/
dist/
build/
*.tsbuildinfo

# Go build artifacts
backend/server
backend/bin/
backend/tmp/

# Goa generated code
backend/internal/api/gen/

# Test coverage
coverage/
backend/coverprofile.out

# SQLite database files
*.db
*.sqlite
*.sqlite3
data/

# Environment files
.envrc
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Dataset placeholder for Docker Compose
.dataset-placeholder/

# Local config (gitignored; use config.yaml.example as template)
config.yaml

# E2E test artifacts
.e2e/
frontend/playwright-report/
frontend/test-results/

# Debug mode output (agent decision logs from ralph-auto-debug)
.ralph-debug/
.debug-context

# Python cache
__pycache__/
*.pyc

# Spike POC generated files
docs/spike-poc/*/testdata/
docs/spike-poc/*/output/

# Temp files from container
./tmp/

# Agent metadata (its own git repo) and the work-item store
/.claude-sandbox/
/.work-items/
